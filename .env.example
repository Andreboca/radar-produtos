# OPCIONAL: tudo isto pode ser preenchido pela aba Conexões do app.
# Use este arquivo só se preferir configurar por aqui (copie para .env.local).
# Cada plataforma funciona sozinha: comece pela que já tem credencial.

# ── FastMoss (produtos em alta e vídeos do TikTok Shop) ───────
# Chave da OpenAPI da FastMoss. No Railway, cole em Variables como FASTMOSS_TOKEN.
# Sem ela o painel mostra 0 produtos.
FASTMOSS_TOKEN=

# ── Mercado Livre ─────────────────────────────────────────────
# Crie um aplicativo em https://developers.mercadolivre.com.br/devcenter
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
# Opcional: se já tiver um access token gerado, ele é usado no lugar do par acima.
MELI_ACCESS_TOKEN=

# ── Shopee (programa de afiliados) ────────────────────────────
# Cadastre-se em https://affiliate.shopee.com.br e, depois de aprovado,
# pegue o App ID e o Secret na seção "Open API" do painel.
SHOPEE_APP_ID=
SHOPEE_SECRET=

# ── TikTok Shop (integração não testada) ──────────────────────
# App aprovado em https://partner.tiktokshop.com + access token de criador.
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=

# ── Avisos pelo Telegram ──────────────────────────────────────
# Fale com @BotFather no Telegram, envie /newbot e copie o token.
# Depois mande "oi" ao seu bot e clique em "Conectar Telegram" na aba Alertas:
# o app descobre o chat id sozinho. (TELEGRAM_CHAT_ID só se quiser fixar à mão.)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Monitor ───────────────────────────────────────────────────
# De quantos em quantos minutos checar as plataformas (mínimo 5).
MONITOR_INTERVALO_MIN=30
# Hora do resumo diário (0 a 23, horário de Brasília).
MONITOR_HORA_RESUMO=9

# ── Leitura por IA (opcional) ─────────────────────────────────
# Se preenchida, o resumo diário ganha um comentário da IA apontando as
# melhores oportunidades, usando só os dados das APIs acima.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Envio automático para grupos ──────────────────────────────
# Telegram: adicione o seu bot ao grupo como administrador, mande uma mensagem
# no grupo e pegue o id (número negativo) em
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_GRUPO_ID=

# WhatsApp: escolha um conector (evolution ou zapi). Não são oficiais do
# WhatsApp; use um número separado do pessoal.
WHATSAPP_PROVEDOR=
# ID do grupo: 1203630...@g.us (evolution) ou 1203630...-group (zapi)
WHATSAPP_GRUPO_ID=
# Evolution API (https://doc.evolution-api.com)
EVOLUTION_URL=
EVOLUTION_INSTANCIA=
EVOLUTION_API_KEY=
# Z-API (https://developer.z-api.io)
ZAPI_INSTANCIA=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Quantos produtos por envio (1 a 10) e depois de quantas horas um mesmo
# produto pode ser enviado de novo.
DIVULGACAO_ITENS=5
DIVULGACAO_REPETIR_HORAS=24
